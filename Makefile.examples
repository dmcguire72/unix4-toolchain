CC11 = ./bin/cc11
LD = /opt/v4/sys/bin/cc
AS = /opt/v4/sys/bin/as
AR = /opt/v4/sys/bin/ar
STRIP = /opt/v4/sys/bin/strip

CFLAGS =
BIN = example/bin
OBJ = example/obj

LIB_PROGRAMS = crypttest alloctest hello
PLAIN_PROGRAMS = char crash float quine
PROGRAMS = $(PLAIN_PROGRAMS) $(LIB_PROGRAMS)

TARGETS = $(PROGRAMS:%=$(BIN)/%)
OBJECTS = $(PROGRAMS:%=$(OBJ)/%.o) \
          $(OBJ)/allocator.o $(OBJ)/io.o $(OBJ)/lib.o

GENERATED_ASM = $(PROGRAMS:%=example/%.s) \
                example/lib/allocator.s example/lib/io.s \
                $(PROGRAMS:%=$(OBJ)/%.s) \
                $(OBJ)/allocator.s $(OBJ)/io.s

.PHONY: all clean strip

all: $(TARGETS)

strip: all
	@for f in $(TARGETS); do \
		echo "STRIP $$f"; \
		$(STRIP) "$$f" || true; \
	done

$(BIN) $(OBJ):
	@mkdir -p $@

define COMPILE_OBJECT
	@rm -f a.out $(basename $(1)).s $(@:.o=.s) $@
	@echo "CC -S $(CFLAGS) $(1)"
	@$(CC11) -S $(CFLAGS) $(1) || exit $$?
	@test -f $(basename $(1)).s
	@mv $(basename $(1)).s $(@:.o=.s)
	@echo "AS $(@:.o=.s)"
	@output=$$($(AS) -g $(@:.o=.s) 2>&1); status=$$?; \
		if test -n "$$output" || test ! -f a.out || \
		   { test $$status -ne 0 && test $$status -ne 2; }; then \
			rm -f a.out; exit 1; \
		fi; \
		mv a.out $@
endef

$(OBJ)/%.o: example/%.c | $(OBJ)
	$(call COMPILE_OBJECT,$<)

$(OBJ)/allocator.o: example/lib/allocator.c | $(OBJ)
	$(call COMPILE_OBJECT,$<)

$(OBJ)/io.o: example/lib/io.c | $(OBJ)
	$(call COMPILE_OBJECT,$<)

$(OBJ)/lib.o: $(OBJ)/allocator.o $(OBJ)/io.o
	@rm -f $@
	@echo "AR r $@ $(OBJ)/allocator.o $(OBJ)/io.o"
	@$(AR) r $@ $(OBJ)/allocator.o $(OBJ)/io.o

define LINK_PROGRAM
	@rm -f a.out
	@echo "LD $(1)"
	@$(LD) $(1); test -f a.out
	@mv a.out $(2)
endef

$(PLAIN_PROGRAMS:%=$(BIN)/%): $(BIN)/%: $(OBJ)/%.o | $(BIN)
	$(call LINK_PROGRAM,$^,$@)

$(LIB_PROGRAMS:%=$(BIN)/%): $(BIN)/%: $(OBJ)/%.o $(OBJ)/lib.o | $(BIN)
	$(call LINK_PROGRAM,$^,$@)

clean:
	@rm -f $(TARGETS) $(OBJECTS) a.out
	@rm -f $(GENERATED_ASM)