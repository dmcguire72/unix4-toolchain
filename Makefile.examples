MAKEFLAGS += -r
.SUFFIXES:

V4_CC11 ?= $(if $(wildcard ./bin/cc11),./bin/cc11,/usr/bin/v4-cc)
V4_AR ?= $(if $(wildcard ./bin/ar),./bin/ar,/usr/bin/v4-ar)
V4_STRIP ?= $(if $(wildcard ./bin/strip),./bin/strip,/usr/bin/v4-strip)
V4_CC2 := $(or $(wildcard ./bin/cc2),$(wildcard /opt/v4/sys/lib/c2))

CC = $(V4_CC11)
AR = $(V4_AR)
STRIP = $(V4_STRIP)

ifneq ($(V4_CC2),)
  V4_CFLAGS ?= -O
else
  V4_CFLAGS ?=
endif
CFLAGS = $(V4_CFLAGS)

BIN = example/bin
OBJ = example/obj

ifeq ($(V),1)
  Q :=
  ECHO := @:
else
  Q := @
  ECHO := @printf "  %-7s %s\n"
endif

PLAIN_PROGRAMS = char crash float quine cal
LIB_PROGRAMS = crypttest alloctest hello
PROGRAMS = $(PLAIN_PROGRAMS) $(LIB_PROGRAMS)

LIB_TARGETS = allocator io string
LIB_OBJECTS = $(LIB_TARGETS:%=$(OBJ)/%.o)

TARGETS = $(PROGRAMS:%=$(BIN)/%)
OBJECTS = $(LIB_OBJECTS) $(OBJ)/lib.a

.PHONY: all clean strip

all: $(TARGETS)

strip: all
	@for f in $(TARGETS); do \
		if [ "$(V)" = "1" ]; then \
			echo $(STRIP) "$$f"; \
		else \
			printf "  %-7s %s\n" STRIP "$$f"; \
		fi; \
		$(STRIP) "$$f"; \
	done

$(BIN) $(OBJ):
	$(ECHO) MKDIR $@
	$(Q)mkdir -p $@

define COMPILE_OBJECT
	$(ECHO) CC $(2)
	$(Q)rm -f a.out $(basename $(1)).o $(2)
	$(Q)$(CC) $(CFLAGS) -c $(1) || [ $$? -eq 1 ]
	$(Q)test -s $(basename $(1)).o || { \
		echo "CC failed: no object generated for $(1)"; \
		exit 1; \
	}
	$(Q)mv $(basename $(1)).o $(2)
endef

define BUILD_BINARY
	$(ECHO) CC $(2)
	$(Q)rm -f a.out $(2)
	$(Q)$(CC) $(CFLAGS) $(1) || [ $$? -eq 1 ]
	$(Q)test -s a.out || { \
		echo "CC failed: no executable generated for $(2)"; \
		exit 1; \
	}
	$(Q)mv a.out $(2)
endef

$(LIB_OBJECTS): $(OBJ)/%.o: example/lib/%.c | $(OBJ)
	$(call COMPILE_OBJECT,$<,$@)

$(OBJ)/pvm.o: extra/pvm/unix4/pvm.c extra/pvm/unix4/pvm-common.h | $(OBJ)
	$(Q)cp extra/pvm/unix4/pvm-common.h example/pvm-common.h
	$(call COMPILE_OBJECT,$<,$@)
	$(Q)rm -f example/pvm-common.h

$(OBJ)/lib.a: $(LIB_OBJECTS)
	$(ECHO) AR $@
	$(Q)rm -f $@
	$(Q)$(AR) r $@ $^

$(PLAIN_PROGRAMS:%=$(BIN)/%): $(BIN)/%: example/%.c | $(BIN)
	$(call BUILD_BINARY,$<,$@)

$(LIB_PROGRAMS:%=$(BIN)/%): $(BIN)/%: example/%.c $(OBJ)/lib.a | $(BIN)
	$(call BUILD_BINARY,$^,$@)

clean:
	$(ECHO) CLEAN "$(BIN) $(OBJ)"
	$(Q)rm -f $(TARGETS) $(OBJECTS) a.out
	$(Q)rm -f $(PROGRAMS:%=example/%.o)
	$(Q)rm -f $(LIB_TARGETS:%=example/lib/%.o)