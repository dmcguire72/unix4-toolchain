MAKEFLAGS += -r
.SUFFIXES:

CC11 = ./bin/cc11
AR = /opt/v4/sys/bin/ar
STRIP = /opt/v4/sys/bin/strip

CFLAGS =
BIN = example/bin
OBJ = example/obj

ifeq ($(V),1)
  Q :=
  ECHO := @:
else
  Q := @
  ECHO := @printf "  %-7s %s\n"
endif

PLAIN_PROGRAMS = char crash float quine
LIB_PROGRAMS = crypttest alloctest hello
PROGRAMS = $(PLAIN_PROGRAMS) $(LIB_PROGRAMS)

TARGETS = $(PROGRAMS:%=$(BIN)/%)
OBJECTS = $(OBJ)/allocator.o $(OBJ)/io.o $(OBJ)/lib.o

.PHONY: all clean strip

all: $(TARGETS)

strip: all
	@for f in $(TARGETS); do \
		if [ "$(V)" = "1" ]; then \
			echo $(STRIP) "$$f"; \
		else \
			printf "  %-7s %s\n" STRIP "$$f"; \
		fi; \
		$(STRIP) "$$f" || true; \
	done

$(BIN) $(OBJ):
	$(ECHO) MKDIR $@
	$(Q)mkdir -p $@

define COMPILE_OBJECT
	$(ECHO) CC $(2)
	$(Q)rm -f a.out $(basename $(1)).o $(2)
	$(Q)$(CC11) $(CFLAGS) -c $(1) || true
	$(Q)test -s $(basename $(1)).o || { \
		echo "CC failed: no object generated for $(1)"; \
		exit 1; \
	}
	$(Q)mv $(basename $(1)).o $(2)
endef

define BUILD_BINARY
	$(ECHO) CC $(2)
	$(Q)rm -f a.out $(2)
	$(Q)$(CC11) $(CFLAGS) $(1) || true
	$(Q)test -s a.out || { \
		echo "CC failed: no executable generated for $(2)"; \
		exit 1; \
	}
	$(Q)mv a.out $(2)
endef

$(OBJ)/allocator.o: example/lib/allocator.c | $(OBJ)
	$(call COMPILE_OBJECT,$<,$@)

$(OBJ)/io.o: example/lib/io.c | $(OBJ)
	$(call COMPILE_OBJECT,$<,$@)

$(OBJ)/pvm.o: extra/pvm/unix4/pvm.c extra/pvm/unix4/pvm-common.h | $(OBJ)
	$(Q)cp extra/pvm/unix4/pvm-common.h example/pvm-common.h
	$(call COMPILE_OBJECT,$<,$@)
	$(Q)rm -f example/pvm-common.h

$(OBJ)/lib.o: $(OBJ)/allocator.o $(OBJ)/io.o
	$(ECHO) AR $@
	$(Q)rm -f $@
	$(Q)$(AR) r $@ $(OBJ)/allocator.o $(OBJ)/io.o

$(PLAIN_PROGRAMS:%=$(BIN)/%): $(BIN)/%: example/%.c | $(BIN)
	$(call BUILD_BINARY,$<,$@)

$(LIB_PROGRAMS:%=$(BIN)/%): $(BIN)/%: example/%.c $(OBJ)/lib.o | $(BIN)
	$(call BUILD_BINARY,$^,$@)

clean:
	$(ECHO) CLEAN "$(BIN) $(OBJ)"
	$(Q)rm -f $(TARGETS) $(OBJECTS) a.out
	$(Q)rm -f $(PROGRAMS:%=example/%.o)
	$(Q)rm -f example/lib/allocator.o example/lib/io.o