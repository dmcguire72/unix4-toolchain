# cc11 file.c [file.s]

dir=$(dirname "$0")
src=$1
out=${2:-${src%.c}.s}

[ -n "$src" ] || { echo "usage: cc11 file.c [file.s]" >&2; exit 2; }

build=${BUILD_DIR:-"$dir/build"}
if [ -x "$build/bin/c0" ] && [ -x "$build/bin/c1" ]; then
    C0="$build/bin/c0"
    C1="$build/bin/c1"
elif [ -x "$build/c0" ] && [ -x "$build/c1" ]; then
    C0="$build/c0"
    C1="$build/c1"
elif [ -x "$dir/c0" ] && [ -x "$dir/c1" ]; then
    C0="$dir/c0"
    C1="$dir/c1"
else
    echo "cc11: error: passes c0/c1 not found. Run 'make' first." >&2
    exit 1
fi

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
"$C0" "$src" "$tmp/i" "$tmp/t" && "$C1" "$tmp/i" "$tmp/t" "$out"